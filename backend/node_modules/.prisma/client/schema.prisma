// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Admin ────────────────────────────────────────────────────────────────────
model Admin {
  id           Int      @id @default(autoincrement())
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("admins")
}

// ─── Student ──────────────────────────────────────────────────────────────────
model Student {
  id            Int      @id @default(autoincrement())
  name          String
  fatherName    String?  @map("father_name")
  class         String // "11" | "12"
  rollNumber    String?  @map("roll_number")
  contact       String?
  admissionDate String?  @map("admission_date")
  status        String   @default("active") // active | inactive
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  subjects   StudentSubject[]
  feeRecords MonthlyFeeRecord[]

  @@map("students")
}

// ─── Per-student subject fee configuration ────────────────────────────────────
model StudentSubject {
  id            Int    @id @default(autoincrement())
  studentId     Int    @map("student_id")
  subjectName   String @map("subject_name")
  monthlyAmount Float  @map("monthly_amount")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, subjectName])
  @@map("student_subjects")
}

// ─── Monthly fee record (one per student per month/year) ─────────────────────
model MonthlyFeeRecord {
  id              Int      @id @default(autoincrement())
  studentId       Int      @map("student_id")
  month           Int // 1-12
  year            Int
  totalFee        Float    @map("total_fee")
  amountPaid      Float    @default(0) @map("amount_paid")
  remainingAmount Float    @map("remaining_amount")
  status          String   @default("UNPAID") // PAID | PARTIAL | UNPAID
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  student          Student                      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectBreakdown MonthlyFeeSubjectBreakdown[]
  payments         Payment[]

  @@unique([studentId, month, year])
  @@map("monthly_fee_records")
}

// ─── Subject-wise breakdown stored per fee record ─────────────────────────────
model MonthlyFeeSubjectBreakdown {
  id          Int    @id @default(autoincrement())
  feeRecordId Int    @map("fee_record_id")
  subjectName String @map("subject_name")
  amount      Float

  feeRecord MonthlyFeeRecord @relation(fields: [feeRecordId], references: [id], onDelete: Cascade)

  @@unique([feeRecordId, subjectName])
  @@map("monthly_fee_subject_breakdowns")
}

// ─── Individual payment transactions (multiple allowed per month record) ───────
model Payment {
  id          Int      @id @default(autoincrement())
  feeRecordId Int      @map("fee_record_id")
  amountPaid  Float    @map("amount_paid")
  paymentDate String   @map("payment_date") // stored as ISO date string YYYY-MM-DD
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")

  feeRecord MonthlyFeeRecord @relation(fields: [feeRecordId], references: [id], onDelete: Cascade)

  @@map("payments")
}
